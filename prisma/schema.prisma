generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RegistrationStatus {
  REGISTERED
  DROPPED
  COMPLETED
}

enum CourseType {
  COMPULSORY
  ELECTIVE
}

enum ResultStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                  String               @id @default(cuid())
  fullName            String
  email               String               @unique
  username            String?              @unique
  passwordHash        String
  isActive            Boolean              @default(true)
  roleId              String
  role                Role                 @relation(fields: [roleId], references: [id])
  student             Student?
  lecturer            Lecturer?
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  approvedResults     ResultApproval[]     @relation("ResultApprover")
  auditLogs           AuditLog[]           @relation("AuditActor")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([roleId])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Faculty {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String       @unique
  description String?
  departments Department[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  facultyId String
  faculty   Faculty    @relation(fields: [facultyId], references: [id])
  students  Student[]
  lecturers Lecturer[]
  courses   Course[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([name, facultyId])
  @@index([facultyId])
}

model Student {
  id              String                  @id @default(cuid())
  userId          String                  @unique
  registrationNo  String                  @unique
  departmentId    String
  admissionYear   Int
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      Department              @relation(fields: [departmentId], references: [id])
  academicRecords StudentAcademicRecord[]
  registrations   CourseRegistration[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([departmentId])
}

model Lecturer {
  id                String             @id @default(cuid())
  userId            String             @unique
  staffNumber       String             @unique
  departmentId      String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  department        Department         @relation(fields: [departmentId], references: [id])
  courseAssignments CourseAssignment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([departmentId])
}

model AcademicLevel {
  id              String                  @id @default(cuid())
  name            String                  @unique
  levelNumber     Int                     @unique
  academicRecords StudentAcademicRecord[]
  courses         Course[]
}

model AcademicSession {
  id                String                  @id @default(cuid())
  name              String                  @unique
  startDate         DateTime
  endDate           DateTime
  isCurrent         Boolean                 @default(false)
  semesters         Semester[]
  academicRecords   StudentAcademicRecord[]
  courseAssignments CourseAssignment[]
  registrations     CourseRegistration[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
}

model Semester {
  id                String               @id @default(cuid())
  name              String
  academicSessionId String
  academicSession   AcademicSession      @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  courseAssignments CourseAssignment[]
  registrations     CourseRegistration[]
  createdAt         DateTime             @default(now())

  @@unique([name, academicSessionId])
  @@index([academicSessionId])
}

model StudentAcademicRecord {
  id                String          @id @default(cuid())
  studentId         String
  academicSessionId String
  academicLevelId   String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  academicLevel     AcademicLevel   @relation(fields: [academicLevelId], references: [id])
  createdAt         DateTime        @default(now())

  @@unique([studentId, academicSessionId])
  @@index([academicSessionId])
  @@index([academicLevelId])
}

model Course {
  id              String             @id @default(cuid())
  code            String             @unique
  title           String
  description     String?
  creditUnits     Int
  departmentId    String
  academicLevelId String
  courseType      CourseType         @default(COMPULSORY)
  isActive        Boolean            @default(true)

  department      Department         @relation(fields: [departmentId], references: [id])
  academicLevel   AcademicLevel      @relation(fields: [academicLevelId], references: [id])
  assignments     CourseAssignment[]
  registrations   CourseRegistration[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([departmentId])
  @@index([academicLevelId])
}

model CourseAssignment {
  id                String               @id @default(cuid())
  courseId          String
  lecturerId        String
  academicSessionId String
  semesterId        String
  course            Course               @relation(fields: [courseId], references: [id])
  lecturer          Lecturer             @relation(fields: [lecturerId], references: [id])
  academicSession   AcademicSession      @relation(fields: [academicSessionId], references: [id])
  semester          Semester             @relation(fields: [semesterId], references: [id])
  registrations     CourseRegistration[]
  createdAt         DateTime             @default(now())

  @@unique([courseId, lecturerId, academicSessionId, semesterId])
  @@index([lecturerId])
  @@index([academicSessionId, semesterId])
}

model CourseRegistration {
  id                 String             @id @default(cuid())
  studentId          String
  courseId           String
  academicSessionId  String
  semesterId         String
  courseAssignmentId String?
  status             RegistrationStatus @default(REGISTERED)
  student            Student            @relation(fields: [studentId], references: [id])
  course             Course             @relation(fields: [courseId], references: [id])
  academicSession    AcademicSession    @relation(fields: [academicSessionId], references: [id])
  semester           Semester           @relation(fields: [semesterId], references: [id])
  courseAssignment   CourseAssignment?  @relation(fields: [courseAssignmentId], references: [id], onDelete: SetNull)
  result             Result?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([studentId, courseId, academicSessionId, semesterId])
  @@index([studentId])
  @@index([courseId])
  @@index([academicSessionId, semesterId])
}

model Result {
  id             String             @id @default(cuid())
  registrationId String             @unique
  caScore        Decimal            @db.Decimal(5, 2)
  examScore      Decimal            @db.Decimal(5, 2)
  totalScore     Decimal            @db.Decimal(5, 2)
  letterGrade    String?
  gradePoint     Decimal?           @db.Decimal(4, 2)
  status         ResultStatus       @default(DRAFT)
  submittedAt    DateTime?
  approvedAt     DateTime?
  registration   CourseRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  approvals      ResultApproval[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status])
}

model ResultApproval {
  id         String           @id @default(cuid())
  resultId   String
  approverId String
  decision   ApprovalDecision
  comments   String?
  result     Result           @relation(fields: [resultId], references: [id], onDelete: Cascade)
  approver   User             @relation("ResultApprover", fields: [approverId], references: [id])
  createdAt  DateTime         @default(now())

  @@index([resultId])
  @@index([approverId])
}

model GradeScale {
  id          String   @id @default(cuid())
  minScore    Int
  maxScore    Int
  letterGrade String
  gradePoint  Decimal  @db.Decimal(4, 2)
  remark      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([minScore, maxScore])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}
